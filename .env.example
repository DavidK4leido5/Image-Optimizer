# Copy to .env and fill in. Never put real secrets in this file.
API_KEY=change-me
INTERNAL_KEY=change-me
PROCESSOR_URL=http://localhost:5081
MAX_UPLOAD_BYTES=20971520

# local compose
DATABASE_URL=Host=localhost;Port=5432;Database=cloud;Username=postgres;Password=postgres
S3_ENDPOINT=http://localhost:9090
S3_PUBLIC_ENDPOINT=http://localhost:9090
S3_PUBLIC_BASE=http://localhost:9090
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=images
S3_REGION=us-east-1
S3_PATH_STYLE=true

# Grafana Cloud, only needed by the api metrics proxy
# GRAFANA_PROM_URL=https://prometheus-prod-<region>.grafana.net/api/prom
# GRAFANA_USER=<instance id>
# GRAFANA_TOKEN=<access policy token with metrics:read>

# Supabase, production values:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# S3_PUBLIC_BASE=https://<ref>.supabase.co/storage/v1/object/public
